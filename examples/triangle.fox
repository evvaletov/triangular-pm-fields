INCLUDE 'COSY' ;
PROCEDURE RUN ;
 VARIABLE X 1000 ; VARIABLE Y 1000 ; VARIABLE Z 1000 ;
 VARIABLE BX 1000 ; VARIABLE BY 1000 ; VARIABLE BZ 1000 ;
 VARIABLE STATUS 1 ;
 DEF ; OV 6 0 3 ; DAEPS 1E-250 ;
 TRLOAD 'triangle.tan' STATUS ;
 IF STATUS#0 ; WRITE 6 'TRLOAD status ' STATUS ; QUIT -1 ; ENDIF ;
 X := .25+.125*DA(1) ; Y := .25+.125*DA(2) ; Z := .75+.125*DA(3) ;
 TRFLD X Y Z BX BY BZ 1 STATUS ;
 IF STATUS#0 ; WRITE 6 'TRFLD status ' STATUS ; QUIT -1 ; ENDIF ;
 WRITE 6 'mu0 H [T]: ' CONS(BX) CONS(BY) CONS(BZ) ;
 WRITE 6 'x coefficient: ' COEF(BX,1) COEF(BY,1) COEF(BZ,1) ;
ENDPROCEDURE ;
RUN ;
END ;
